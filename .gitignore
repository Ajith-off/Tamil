# Python bytecode from the stroke-data tooling in tools/
__pycache__/
*.pyc

# Machine-specific Claude Code permissions (device ids, absolute temp paths)
.claude/settings.local.json

# Contact sheets from the picture pipeline: review aids, regenerated by
# tools/cut_worksheet_art.py and tools/word_letters.py. The cut-outs
# themselves are kept, because words.json names them by id.
tools/worksheet_art/sheet_*.png
tools/worksheet_art/keepers.png
